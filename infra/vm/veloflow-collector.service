[Unit]
Description=VeloFlow collector (Velib' GBFS feed, every 30 s)
Documentation=https://github.com/HamzaOuba00-1/veloflow/blob/main/docs/deployment.md
Wants=network-online.target
After=network-online.target
# Never give up restarting: a stopped collector means lost data.
StartLimitIntervalSec=0

[Service]
Type=simple
User=veloflow
Group=veloflow
WorkingDirectory=/opt/veloflow/app
Environment=VELOFLOW_COLLECTOR_DATA_DIR=/var/lib/veloflow
# Secrets (healthcheck URL), root-readable only, never in Git. "-": optional.
EnvironmentFile=-/etc/veloflow/veloflow.env
# Log lines reach the journal immediately instead of sitting in a buffer.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/veloflow/app/.venv/bin/veloflow-collector
# SIGTERM triggers our clean stop; give the current request time to finish.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=10

# Hardening: the service can write to its data folder and nowhere else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/veloflow
# Measured footprint is ~80 MB; the cap protects the rest of the VM from a leak.
MemoryMax=300M

[Install]
WantedBy=multi-user.target
