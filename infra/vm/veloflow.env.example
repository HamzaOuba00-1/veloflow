# Copy to /etc/veloflow/veloflow.env on the VM (owner root, mode 600).
# Never commit the real file: each URL lets anyone send pings to your checks.

# healthchecks.io check "veloflow-collector" (period 1 min, grace 10 min)
VELOFLOW_COLLECTOR_HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# healthchecks.io check "veloflow-compact" (cron "20 0 * * *", UTC, grace 1 h)
VELOFLOW_COMPACT_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# healthchecks.io check "veloflow-weather" (period 1 h, grace 1 h)
VELOFLOW_WEATHER_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
